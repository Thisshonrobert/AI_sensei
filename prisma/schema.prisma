generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id            String        @id @db.Uuid
  title         String
  edition       String?
  sourceType    String
  language      String
  fileReference String?
  levelLabel    String?
  levelAuthority String?
  notes         String?
  importBatches ImportBatch[]

  @@map("sources")
}

model ImportBatch {
  id                   String   @id @default(uuid()) @db.Uuid
  sourceId             String   @db.Uuid
  fileHash             String
  pageRangeJson         Json
  extractorVersion     String
  schemaVersion        Int
  status               String
  stagedJson           Json
  validationErrorsJson Json
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  committedAt          DateTime? @db.Timestamptz(6)
  source               Source   @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, fileHash])
  @@index([createdAt])
  @@map("import_batches")
}
