{
  "name": "ai-sensei-import-tools",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.20",
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "lint": "node node_modules/eslint/bin/eslint.js src tests/browser next.config.ts playwright.config.ts",
    "typecheck": "node node_modules/next/dist/bin/next typegen && node node_modules/typescript/bin/tsc --noEmit",
    "test:browser": "node node_modules/@playwright/test/cli.js test",
    "test": "node --test tests/*.test.mjs",
    "import:sanitize": "node scripts/import-batches.mjs --sanitize-only",
    "import:load": "node scripts/import-batches.mjs",
    "import:canonical": "node scripts/canonical-import.mjs",
    "test:canonical": "node scripts/test-canonical-postgres.mjs",
    "test:review": "node scripts/test-review-postgres.mjs",
    "test:review:browser": "node scripts/test-review-postgres.mjs --browser"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "ts-fsrs": "5.4.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.28",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
