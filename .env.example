# Copy to .env and use a unique password. Keep .env private.
POSTGRES_USER=ai_sensei
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=ai_sensei
POSTGRES_PORT=5433
DATABASE_URL="postgresql://ai_sensei:REPLACE_WITH_A_RANDOM_URL_SAFE_PASSWORD@127.0.0.1:5433/ai_sensei?schema=public"
# Persistent content/hosting database. Explicit import commands select this target.
# POSTGRES_DATABASE_URL="postgresql://USER:PASSWORD@EP-PROJECT-pooler.REGION.neon.tech/neondb?sslmode=require"
# Local development and isolated checks. Keep DATABASE_URL local on this machine.
LOCAL_DATABASE_URL="postgresql://ai_sensei:REPLACE_WITH_A_RANDOM_URL_SAFE_PASSWORD@127.0.0.1:5433/ai_sensei?schema=public"
# Optional on-demand practice; keep the API key server-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Set true only after checking that this API-key project uses Free Tier in AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
